PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campusnet?appName=campusnet
JWT_SECRET=replace_with_a_long_random_string
NODE_ENV=production
# Comma-separated list of allowed CORS origins. Include both localhost (for dev) and your Vercel URL (for prod).
# Example: ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app
GEMINI_API_KEY=your_gemini_api_key_here
