# Backend API base URL (no trailing slash). Required.
# Local dev:  http://localhost:5000
# Production: https://your-render-service.onrender.com
VITE_API_URL=http://localhost:5000

# Socket.io connection URL. Optional — falls back to VITE_API_URL if unset.
# Set this only if your socket server is on a different host than the REST API.
VITE_SOCKET_URL=http://localhost:5000
